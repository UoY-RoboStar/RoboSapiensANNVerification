(declare-const X_0 Real)
(declare-const X_1 Real)
(declare-const X_2 Real)
(declare-const X_3 Real)
(declare-const X_4 Real)
(declare-const X_5 Real)
(declare-const X_6 Real)

(declare-const Y_0 Real)
(declare-const Y_1 Real)
(declare-const Y_2 Real)

(assert ( >= X_0 -0.01) )
( assert ( <= X_0 0.01) )
(assert ( >= X_1 -0.01) )
( assert ( <= X_1 0.01) )
(assert ( >= X_2 -0.01) )
( assert ( <= X_2 0.01) )
(assert ( >= X_3 -0.01) )
( assert ( <= X_3 0.01) )
(assert ( >= X_4 -0.01) )
( assert ( <= X_4 0.01) )
(assert ( >= X_5 -0.01) )
( assert ( <= X_5 0.01) )
(assert ( >= X_6 -0.01) )
( assert ( <= X_6 0.01) )

(assert ( <= Y_0 0.0))
